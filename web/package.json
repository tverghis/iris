{
	"name": "web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:mock": "VITE_MOCK_API=true vite",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"test": "vitest run",
		"typecheck": "tsc -b --noEmit",
		"gen:api": "openapi-typescript openapi/iris.yaml -o src/api/schema.d.ts",
		"check:api": "openapi-typescript openapi/iris.yaml -o node_modules/.tmp/schema.check.d.ts && diff -u src/api/schema.d.ts node_modules/.tmp/schema.check.d.ts",
		"check:size": "node scripts/check-size.mjs",
		"preview": "vite preview",
		"lighthouse": "node scripts/lighthouse.mjs",
		"verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:size && npm run check:api"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@tanstack/query-async-storage-persister": "^5.104.5",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-query-persist-client": "^5.104.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"idb-keyval": "^6.3.0",
		"lucide-react": "^1.61.0",
		"openapi-fetch": "^0.17.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"wouter": "^3.13.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@rolldown/plugin-babel": "^0.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"chrome-launcher": "^1.2.2",
		"jsdom": "^30.1.3",
		"lighthouse": "^13.5.0",
		"msw": "^3.0.3",
		"openapi-typescript": "^7.13.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.5"
	}
}
